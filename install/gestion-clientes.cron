SHELL=/bin/sh
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin

# Asterisk can write related CDR legs a few seconds apart. Reconcile only calls
# older than two minutes, and prevent overlapping runs if a database is slow.
* * * * * root /usr/bin/flock -n /var/run/gestion-clientes-reconcile.lock /usr/local/sbin/gestion-clientes-reconcile-cdr --config /etc/issabel/gestion_clientes.conf.php --limit 100 --min-age 120 >/dev/null
