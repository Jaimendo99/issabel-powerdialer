<div class="gc-module"><h2>Mapeo de agentes</h2>
<form method="post" action="{$action_url|escape:'html'}" class="gc-form"><input type="hidden" name="csrf_token" value="{$csrf_token|escape:'html'}" /><input type="hidden" name="idempotency_key" value="{$idempotency_key|escape:'html'}" />
<label>Usuario Issabel <input name="issabel_username" required="required" /></label><label>ID Call Center <input name="callcenter_agent_id" /></label><label>Número de agente <input name="agent_number" required="required" /></label><label>Extensión SIP <input name="sip_extension" required="required" /></label><label><input type="checkbox" name="active" value="1" checked="checked" /> Activo</label><button type="submit">Guardar mapeo</button></form>
<table class="gc-table"><thead><tr><th>Usuario</th><th>Agente</th><th>Extensión</th><th>Activo</th></tr></thead><tbody>{foreach from=$agents item=a}<tr><td>{$a.issabel_username|escape:'html'}</td><td>{$a.agent_number|escape:'html'}</td><td>{$a.sip_extension|escape:'html'}</td><td>{$a.active|escape:'html'}</td></tr>{foreachelse}<tr><td colspan="4">Sin mapeos.</td></tr>{/foreach}</tbody></table></div>
