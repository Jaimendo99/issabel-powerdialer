<div class="gc-module"><h2>{$title|default:'Asignación de clientes'|escape:'html'}</h2><form method="post" action="{$action_url|default:''|escape:'html'}" class="gc-form"><input type="hidden" name="csrf_token" value="{$csrf_token|default:''|escape:'html'}" /><input type="hidden" name="idempotency_key" value="{$idempotency_key|default:''|escape:'html'}" />
<label>{$label_campaign|default:'Campaña'|escape:'html'} <select name="campaign_id" required="required">{foreach from=$campaigns|default:array() item=c}<option value="{$c.id|default:''|escape:'html'}"{if $selected_campaign_id|default:'' == $c.id|default:''} selected="selected"{/if}>{$c.name|default:''|escape:'html'}</option>{/foreach}</select></label>
	<label>Cantidad <input type="number" name="quantity" min="1" max="10000" value="{$quantity|default:50|escape:'html'}" required="required" /></label>
	<fieldset><legend>Agente</legend>{foreach from=$agents|default:array() item=a}<label class="gc-check"><input type="radio" name="agent_ids[]" value="{$a.id|default:''|escape:'html'}" required="required"{if $a.selected|default:0} checked="checked"{/if} /> {$a.name|default:''|escape:'html'}</label>{foreachelse}<p class="gc-empty">{$label_no_agents|default:'No hay agentes habilitados.'|escape:'html'}</p>{/foreach}</fieldset>
{if $preview|default:array()}<div class="gc-alert gc-alert-info">{$preview.total|default:0|escape:'html'} {$label_clients_to_assign|default:'clientes por asignar'|escape:'html'}</div>{/if}<div class="gc-actions"><button name="mode" value="preview" type="submit">{$label_preview|default:'Previsualizar'|escape:'html'}</button><button name="mode" value="commit" type="submit">{$label_assign|default:'Confirmar asignación'|escape:'html'}</button></div></form></div>
