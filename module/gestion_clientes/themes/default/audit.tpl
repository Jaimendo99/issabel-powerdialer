<div class="gc-module"><h2>{$title|default:'Auditoría'|escape:'html'}</h2><form method="get" class="gc-filters" action="{$action_url|default:''|escape:'html'}"><input type="hidden" name="menu" value="gestion_clientes" /><input type="hidden" name="action" value="audit_view" /><label>{$label_user|default:'Usuario'|escape:'html'} <input type="text" name="user" value="{$filters.user|default:''|escape:'html'}" /></label><label>{$label_event|default:'Evento'|escape:'html'} <input type="text" name="event" value="{$filters.event|default:''|escape:'html'}" /></label><button type="submit">{$label_filter|default:'Filtrar'|escape:'html'}</button></form><div class="gc-table-wrap"><table class="gc-table"><thead><tr><th>{$label_date|default:'Fecha'|escape:'html'}</th><th>{$label_user|default:'Usuario'|escape:'html'}</th><th>{$label_event|default:'Evento'|escape:'html'}</th><th>{$label_entity|default:'Entidad'|escape:'html'}</th><th>{$label_request_id|default:'ID de solicitud'|escape:'html'}</th></tr></thead><tbody>{foreach from=$events|default:array() item=row}<tr><td>{$row.created_at|default:''|escape:'html'}</td><td>{$row.actor|default:''|escape:'html'}</td><td>{$row.event|default:''|escape:'html'}</td><td>{$row.entity|default:''|escape:'html'} {$row.entity_id|default:''|escape:'html'}</td><td><code>{$row.request_id|default:''|escape:'html'}</code></td></tr>{foreachelse}<tr><td colspan="5" class="gc-empty">{$label_empty|default:'No hay eventos para mostrar.'|escape:'html'}</td></tr>{/foreach}</tbody></table></div></div>
