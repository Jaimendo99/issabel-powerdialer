<div class="gc-module"><h2>{$title|default:'Callbacks'|escape:'html'}</h2><div class="gc-table-wrap"><table class="gc-table"><thead><tr><th>{$label_when|default:'Fecha y hora'|escape:'html'}</th><th>{$label_client|default:'Cliente'|escape:'html'}</th><th>{$label_agent|default:'Agente'|escape:'html'}</th><th>{$label_note|default:'Nota'|escape:'html'}</th><th>{$label_actions|default:'Acciones'|escape:'html'}</th></tr></thead><tbody>{foreach from=$callbacks|default:array() item=row}<tr class="{if $row.overdue|default:0}gc-overdue{/if}"><td>{$row.scheduled_at|default:''|escape:'html'} <small>{$row.timezone|default:''|escape:'html'}</small></td><td>{$row.client_name|default:''|escape:'html'}</td><td>{$row.agent_name|default:''|escape:'html'}</td><td>{$row.note|default:''|escape:'html'}</td><td><a href="{$row.open_url|default:'#'|escape:'html'}">{$label_open|default:'Abrir'|escape:'html'}</a></td></tr>{foreachelse}<tr><td colspan="5" class="gc-empty">{$label_empty|default:'No hay callbacks en este período.'|escape:'html'}</td></tr>{/foreach}</tbody></table></div></div>
