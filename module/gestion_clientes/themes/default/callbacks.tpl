<div class="gc-module"><h2>{$title|default:'Callbacks'|escape:'html'}</h2><div class="gc-table-wrap"><table class="gc-table"><thead><tr><th>{$label_when|default:'Fecha y hora'|escape:'html'}</th><th>{$label_client|default:'Cliente'|escape:'html'}</th><th>{$label_agent|default:'Agente'|escape:'html'}</th><th>{$label_note|default:'Nota'|escape:'html'}</th><th>{$label_actions|default:'Acciones'|escape:'html'}</th></tr></thead><tbody>{foreach from=$callbacks|default:array() item=row}<tr class="{if $row.overdue|default:0}gc-overdue{/if}"><td>{$row.scheduled_at|default:''|escape:'html'} <small>{$row.timezone|default:''|escape:'html'}</small></td><td>{$row.client_name|default:''|escape:'html'}</td><td>{$row.agent_name|default:''|escape:'html'}</td><td>{$row.note|default:''|escape:'html'}</td><td><div class="gc-callback-actions">{if $row.can_open|default:0}<form method="post" action="{$reopen_url|default:''|escape:'html'}"><input type="hidden" name="csrf_token" value="{$csrf_token|default:''|escape:'html'}" /><input type="hidden" name="idempotency_key" value="{$row.reopen_idempotency_key|default:''|escape:'html'}" /><input type="hidden" name="client_id" value="{$row.client_id|default:0|escape:'html'}" /><button type="submit">{$label_open|default:'Abrir'|escape:'html'}</button></form>{/if}<details class="gc-callback-manage"><summary>Reprogramar</summary><form method="post" action="{$manage_url|default:''|escape:'html'}" class="gc-form"><input type="hidden" name="csrf_token" value="{$csrf_token|default:''|escape:'html'}" /><input type="hidden" name="idempotency_key" value="{$row.manage_idempotency_key|default:''|escape:'html'}" /><input type="hidden" name="callback_id" value="{$row.id|default:0|escape:'html'}" /><input type="hidden" name="callback_action" value="RESCHEDULE" /><label>Fecha y hora <input type="text" name="callback_at" value="{$row.scheduled_at|default:''|escape:'html'}" placeholder="AAAA-MM-DD HH:MM" required="required" /></label><label>Zona horaria <input type="text" name="callback_timezone" value="{$row.timezone|default:'America/Guayaquil'|escape:'html'}" required="required" /></label><label>Nota <textarea name="note" rows="3" maxlength="2000" required="required">{$row.note|default:''|escape:'html'}</textarea></label><button type="submit">Guardar nueva fecha</button></form></details><form method="post" action="{$manage_url|default:''|escape:'html'}" onsubmit="return confirm('¿Cancelar este callback?');"><input type="hidden" name="csrf_token" value="{$csrf_token|default:''|escape:'html'}" /><input type="hidden" name="idempotency_key" value="{$row.manage_idempotency_key|default:''|escape:'html'}-cancel" /><input type="hidden" name="callback_id" value="{$row.id|default:0|escape:'html'}" /><input type="hidden" name="callback_action" value="CANCEL" /><button type="submit" class="gc-button-danger">Cancelar callback</button></form></div></td></tr>{foreachelse}<tr><td colspan="5" class="gc-empty">{$label_empty|default:'No hay callbacks en este período.'|escape:'html'}</td></tr>{/foreach}</tbody></table></div></div>
