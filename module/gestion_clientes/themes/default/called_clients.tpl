<div class="gc-module">
  <div class="gc-heading"><div><h2>{$title|default:'Mis clientes llamados'|escape:'html'}</h2><p class="gc-page-help">Los resultados son etiquetas informativas. Solo “Volver a llamar” programa una acción automática.</p></div><a class="button gc-button-secondary" href="{$workspace_url|default:'#'|escape:'html'}">Volver a mi cartera</a></div>
  <div class="gc-table-wrap"><table class="gc-table"><thead><tr><th>Última llamada</th><th>Cliente</th><th>Número</th><th>Resultado</th><th>Nota</th><th>Intentos</th><th>Próxima llamada</th><th>Acción</th></tr></thead><tbody>
  {foreach from=$clients|default:array() item=row}<tr><td>{$row.called_at|default:''|escape:'html'}</td><td><strong>{$row.display_name|default:''|escape:'html'}</strong><br /><small>{$row.external_key|default:''|escape:'html'} · {$row.campaign_name|default:''|escape:'html'}</small></td><td>{$row.phone_number|default:''|escape:'html'}</td><td>{$row.outcome_label|default:'Sin resultado'|escape:'html'}<br /><small>{$row.technical_state|default:''|escape:'html'}</small></td><td>{$row.agent_note|default:''|escape:'html'}</td><td>{$row.attempt_count|default:0|escape:'html'}</td><td>{if $row.callback_at|default:''}{$row.callback_at|escape:'html'}{else}—{/if}</td><td>{if $row.can_reopen|default:0}<form method="post" action="{$reopen_url|default:''|escape:'html'}"><input type="hidden" name="csrf_token" value="{$csrf_token|default:''|escape:'html'}" /><input type="hidden" name="idempotency_key" value="{$row.reopen_idempotency_key|default:''|escape:'html'}" /><input type="hidden" name="client_id" value="{$row.client_id|default:0|escape:'html'}" /><button type="submit">Abrir</button></form>{else}<span class="gc-muted">No disponible</span>{/if}</td></tr>{foreachelse}<tr><td colspan="8" class="gc-empty">Todavía no ha llamado a ningún cliente.</td></tr>{/foreach}
  </tbody></table></div>
</div>
