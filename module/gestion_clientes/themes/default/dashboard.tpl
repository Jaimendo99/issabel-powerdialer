<div class="gc-module"><div class="gc-heading"><h2>{$title|default:'Panel operativo'|escape:'html'}</h2><a href="{$export_url|default:'#'|escape:'html'}">{$label_export|default:'Exportar CSV'|escape:'html'}</a></div>
<form method="get" class="gc-filters" action="{$action_url|default:''|escape:'html'}"><input type="hidden" name="menu" value="gestion_clientes" /><input type="hidden" name="action" value="dashboard" /><input type="hidden" name="campaign_id" value="{$campaign_id|default:0|escape:'html'}" /><label>{$label_from|default:'Desde'|escape:'html'} <input type="text" name="from" value="{$filters.from|default:''|escape:'html'}" /></label><label>{$label_to|default:'Hasta'|escape:'html'} <input type="text" name="to" value="{$filters.to|default:''|escape:'html'}" /></label><button type="submit">{$label_apply|default:'Aplicar'|escape:'html'}</button></form>
<p class="gc-scope">{$scope_label|default:'Período seleccionado'|escape:'html'} · {$timezone|default:'UTC'|escape:'html'}</p><div class="gc-summary">{foreach from=$metrics|default:array() item=m}<div><strong>{$m.value|default:0|escape:'html'}</strong><span>{$m.label|default:''|escape:'html'}</span><small>{$m.scope|default:''|escape:'html'}</small></div>{/foreach}</div>
{foreach from=$tables|default:array() item=t}<h3>{$t.title|default:''|escape:'html'}</h3><div class="gc-table-wrap"><table class="gc-table"><thead><tr>{foreach from=$t.columns|default:array() item=c}<th>{$c.label|default:''|escape:'html'}</th>{/foreach}</tr></thead><tbody>{foreach from=$t.rows|default:array() item=row}<tr>{foreach from=$t.columns|default:array() item=c}<td>{$row[$c.key]|default:''|escape:'html'}</td>{/foreach}</tr>{foreachelse}<tr><td colspan="{$t.columns|default:array()|@count}">{$label_empty|default:'Sin datos.'|escape:'html'}</td></tr>{/foreach}</tbody></table></div>{/foreach}</div>
