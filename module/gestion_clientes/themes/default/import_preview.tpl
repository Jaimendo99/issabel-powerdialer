<div class="gc-module"><h2>{$title|default:'Vista previa de importación'|escape:'html'}</h2>
<div class="gc-summary"><div><strong>{$summary.valid|default:0|escape:'html'}</strong><span>{$label_valid|default:'Válidos'|escape:'html'}</span></div><div><strong>{$summary.invalid|default:0|escape:'html'}</strong><span>{$label_invalid|default:'Con errores'|escape:'html'}</span></div><div><strong>{$summary.duplicates|default:0|escape:'html'}</strong><span>{$label_duplicates|default:'Duplicados'|escape:'html'}</span></div></div>
{if $errors|default:array()}<div class="gc-alert gc-alert-error"><ul>{foreach from=$errors item=e}<li>{$e|escape:'html'}</li>{/foreach}</ul></div>{/if}
<div class="gc-table-wrap"><table class="gc-table"><thead><tr><th>#</th><th>{$label_external_id|default:'ID externo'|escape:'html'}</th><th>{$label_client|default:'Cliente'|escape:'html'}</th><th>{$label_phones|default:'Teléfonos'|escape:'html'}</th><th>{$label_result|default:'Resultado'|escape:'html'}</th></tr></thead><tbody>{foreach from=$rows|default:array() item=row}<tr class="{if $row.valid|default:0}gc-valid{else}gc-invalid{/if}"><td>{$row.number|default:''|escape:'html'}</td><td>{$row.external_id|default:''|escape:'html'}</td><td>{$row.name|default:''|escape:'html'}</td><td>{$row.phones|default:''|escape:'html'}</td><td>{$row.message|default:''|escape:'html'}</td></tr>{foreachelse}<tr><td colspan="5" class="gc-empty">{$label_empty|default:'No hay filas para previsualizar.'|escape:'html'}</td></tr>{/foreach}</tbody></table></div>
<form method="post" action="{$commit_url|default:''|escape:'html'}" class="gc-actions"><input type="hidden" name="csrf_token" value="{$csrf_token|default:''|escape:'html'}" /><input type="hidden" name="import_token" value="{$import_token|default:''|escape:'html'}" /><input type="hidden" name="idempotency_key" value="{$idempotency_key|default:''|escape:'html'}" /><button type="submit"{if !$summary.valid|default:0} disabled="disabled"{/if}>{$label_commit|default:'Confirmar importación'|escape:'html'}</button><a href="{$cancel_url|default:'#'|escape:'html'}">{$label_cancel|default:'Cancelar'|escape:'html'}</a></form></div>
