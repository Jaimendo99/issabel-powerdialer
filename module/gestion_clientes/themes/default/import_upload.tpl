<div class="gc-module"><h2>Importar clientes</h2><form method="post" enctype="multipart/form-data" action="{$action_url|escape:'html'}" class="gc-form"><input type="hidden" name="csrf_token" value="{$csrf_token|escape:'html'}" /><input type="hidden" name="idempotency_key" value="{$idempotency_key|escape:'html'}" />
<label>Campaña <select name="campaign_id">{foreach from=$campaigns item=c}<option value="{$c.id|escape:'html'}">{$c.name|escape:'html'}</option>{/foreach}</select></label><label>Archivo CSV <input type="file" name="csv_file" accept=".csv,text/csv" required="required" /></label><label>Columna ID externo <input name="external_id" required="required" /></label><label>Columna nombre <input name="display_name" required="required" /></label><label>Columnas de teléfono (separadas por coma) <input name="phones" required="required" /></label><button type="submit">Validar e importar</button></form></div>
